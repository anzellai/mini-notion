module Db exposing
    ( Page
    , initSchema
    , listPages
    , getPage
    , createPage
    , savePage
    , deletePage
    )

-- Db -- the pages table.
--
-- Std.Auth manages its own users + sessions tables when [auth] is
-- configured in sky.toml. We only own the pages table here, which is
-- the entire point of an MVP scope cut: don't reinvent what the
-- standard library already does.
--
-- Every helper returns Task Error a. They open the DB connection on
-- each call (cheap for SQLite, the OS caches the file). The Task
-- chain composes through Task.andThen and Task.map.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.Db as StdDb


dbPath : String
dbPath =
    "mini-notion.db"


-- ─── Schema ──────────────────────────────────────────────────────

pagesSchema : String
pagesSchema =
    "CREATE TABLE IF NOT EXISTS pages (id INTEGER PRIMARY KEY AUTOINCREMENT, owner_id INTEGER NOT NULL, title TEXT NOT NULL DEFAULT 'Untitled', content TEXT NOT NULL DEFAULT '', updated_at TEXT DEFAULT (datetime('now')))"


initSchema : Task Error ()
initSchema =
    StdDb.open "sqlite" dbPath
        |> Task.andThen (\db -> StdDb.execRaw db pagesSchema)
        |> Task.map (\_ -> ())


-- ─── Page record ─────────────────────────────────────────────────

type alias Page =
    { id : Int
    , title : String
    , content : String
    , updatedAt : String
    }


parseInt : String -> Int
parseInt s =
    case String.toInt s of
        Just n ->
            n

        Nothing ->
            0


rowToPage row =
    { id = parseInt (StdDb.getField "id" row)
    , title = StdDb.getField "title" row
    , content = StdDb.getField "content" row
    , updatedAt = StdDb.getField "updated_at" row
    }


-- ─── CRUD ────────────────────────────────────────────────────────

listPages : Int -> Task Error (List Page)
listPages ownerId =
    StdDb.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                StdDb.query db
                    "SELECT id, title, content, updated_at FROM pages WHERE owner_id = ? ORDER BY updated_at DESC"
                    [ String.fromInt ownerId ]
            )
        |> Task.map (\rows -> List.map rowToPage rows)


getPage : Int -> Int -> Task Error (Maybe Page)
getPage pageId ownerId =
    StdDb.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                StdDb.query db
                    "SELECT id, title, content, updated_at FROM pages WHERE id = ? AND owner_id = ? LIMIT 1"
                    [ String.fromInt pageId, String.fromInt ownerId ]
            )
        |> Task.map
            (\rows ->
                case List.head rows of
                    Just row ->
                        Just (rowToPage row)

                    Nothing ->
                        Nothing
            )


createPage : Int -> Task Error Int
createPage ownerId =
    StdDb.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                StdDb.exec db
                    "INSERT INTO pages (owner_id, title, content) VALUES (?, 'Untitled', '')"
                    [ String.fromInt ownerId ]
                    |> Task.andThen
                        (\_ ->
                            StdDb.query db "SELECT last_insert_rowid() AS id" []
                        )
            )
        |> Task.map
            (\rows ->
                case List.head rows of
                    Just row ->
                        parseInt (StdDb.getField "id" row)

                    Nothing ->
                        0
            )


savePage : Int -> Int -> String -> String -> Task Error Int
savePage pageId ownerId title content =
    StdDb.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                StdDb.exec db
                    "UPDATE pages SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ? AND owner_id = ?"
                    [ title, content, String.fromInt pageId, String.fromInt ownerId ]
            )


deletePage : Int -> Int -> Task Error Int
deletePage pageId ownerId =
    StdDb.open "sqlite" dbPath
        |> Task.andThen
            (\db ->
                StdDb.exec db
                    "DELETE FROM pages WHERE id = ? AND owner_id = ?"
                    [ String.fromInt pageId, String.fromInt ownerId ]
            )
        |> Task.map (\_ -> pageId)
