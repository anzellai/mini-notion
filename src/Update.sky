module Update exposing (update)

-- Update -- message handlers for mini-Notion Part 2.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.String as String
import Std.Cmd as Cmd
import Std.Log exposing (println)

import Model exposing (..)
import Auth
import Db


update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of
        -- Auth routing -------------------------------------------------
        NavigateSignIn ->
            ( { model | page = SignInView, authError = "" }, Cmd.none )

        NavigateSignUp ->
            ( { model | page = SignUpView, authError = "" }, Cmd.none )

        UpdateSignInEmail v ->
            ( { model | signInEmail = v }, Cmd.none )

        UpdateSignInPassword v ->
            ( { model | signInPassword = v }, Cmd.none )

        UpdateSignUpEmail v ->
            ( { model | signUpEmail = v }, Cmd.none )

        UpdateSignUpPassword v ->
            ( { model | signUpPassword = v }, Cmd.none )

        SubmitSignIn ->
            ( { model | authError = "" }
            , Cmd.perform
                (Auth.login model.signInEmail model.signInPassword)
                SignedIn
            )

        SubmitSignUp ->
            ( { model | authError = "" }
            , Cmd.perform
                (Auth.register model.signUpEmail model.signUpPassword)
                SignedUp
            )

        SignedIn (Ok session) ->
            ( { model
                | session = Just session
                , page = AppView
                , signInPassword = ""
                , signInEmail = ""
              }
            , Cmd.perform (Db.listPages session.id session.email) PagesLoaded
            )

        SignedIn (Err e) ->
            ( { model | authError = friendlyAuthError e, signInPassword = "" }
            , Cmd.none
            )

        SignedUp (Ok session) ->
            ( { model
                | session = Just session
                , page = AppView
                , signUpPassword = ""
                , signUpEmail = ""
              }
            , Cmd.perform (Db.listPages session.id session.email) PagesLoaded
            )

        SignedUp (Err e) ->
            ( { model | authError = friendlyAuthError e, signUpPassword = "" }
            , Cmd.none
            )

        SignOut ->
            ( { initialModel | page = SignInView }, Cmd.none )

        -- Pages --------------------------------------------------------
        PagesLoaded (Ok pages) ->
            let
                firstId =
                    case List.head pages of
                        Just p ->
                            Just p.id

                        Nothing ->
                            Nothing

                draft =
                    case List.head pages of
                        Just p ->
                            p.content

                        Nothing ->
                            ""
            in
                ( { model
                    | pages = pages
                    , selected = firstId
                    , draft = draft
                    , saveState = Saved
                  }
                , loadSharesIfSelected firstId
                )

        PagesLoaded (Err e) ->
            let
                _ =
                    println ("[mini-notion] PagesLoaded: " ++ Error.toString e)
            in
                ( { model | notice = "Could not load pages." }
                , Cmd.none
                )

        SelectPage pageId ->
            case model.session of
                Just s ->
                    ( { model | selected = Just pageId, saveState = Saved }
                    , Cmd.batch
                        [ Cmd.perform (Db.getPage pageId s.id s.email) PageContentLoaded
                        , Cmd.perform (Db.listShares pageId) SharesLoaded
                        ]
                    )

                Nothing ->
                    ( model, Cmd.none )

        PageContentLoaded (Ok (Just page)) ->
            ( { model | draft = page.content, saveState = Saved }
            , Cmd.none
            )

        PageContentLoaded (Ok Nothing) ->
            ( { model | draft = "", saveState = Saved }
            , Cmd.none
            )

        PageContentLoaded (Err e) ->
            let
                _ =
                    println ("[mini-notion] PageContentLoaded: " ++ Error.toString e)
            in
                ( { model | saveState = SaveError "Could not load page." }
                , Cmd.none
                )

        NewPage ->
            case model.session of
                Just s ->
                    ( model
                    , Cmd.perform (Db.createPage s.id) PageCreated
                    )

                Nothing ->
                    ( model, Cmd.none )

        PageCreated (Ok newId) ->
            let
                page =
                    { id = newId
                    , title = "Untitled"
                    , content = ""
                    , updatedAt = ""
                    , access = "owner"
                    }
            in
                ( { model
                    | pages = page :: model.pages
                    , selected = Just newId
                    , draft = ""
                    , saveState = Saved
                    , shares = []
                  }
                , Cmd.none
                )

        PageCreated (Err e) ->
            let
                _ =
                    println ("[mini-notion] PageCreated: " ++ Error.toString e)
            in
                ( { model | notice = "Could not create page." }
                , Cmd.none
                )

        DeletePage pageId ->
            case model.session of
                Just s ->
                    ( model
                    , Cmd.perform (Db.deletePage pageId s.id) PageDeleted
                    )

                Nothing ->
                    ( model, Cmd.none )

        PageDeleted (Ok pageId) ->
            let
                remaining =
                    List.filter (\p -> p.id /= pageId) model.pages

                newSelected =
                    case model.selected of
                        Just s ->
                            if s == pageId then
                                case List.head remaining of
                                    Just p ->
                                        Just p.id

                                    Nothing ->
                                        Nothing
                            else
                                Just s

                        Nothing ->
                            Nothing
            in
                ( { model
                    | pages = remaining
                    , selected = newSelected
                    , draft = ""
                  }
                , Cmd.none
                )

        PageDeleted (Err e) ->
            let
                _ =
                    println ("[mini-notion] PageDeleted: " ++ Error.toString e)
            in
                ( { model | notice = "Could not delete page." }
                , Cmd.none
                )

        -- Editor -------------------------------------------------------
        EditDraft newDraft ->
            ( { model
                | draft = newDraft
                , saveState = Saving
                , lastTypedAtTick = model.lastTypedAtTick + 1
              }
            , Cmd.perform
                (saveDraftTask model newDraft)
                PageSaved
            )

        PageSaved (Ok _) ->
            let
                newTitle =
                    titleFrom model.draft

                updatedPages =
                    List.map
                        (\p ->
                            case model.selected of
                                Just sid ->
                                    if p.id == sid then
                                        { p | title = newTitle }
                                    else
                                        p

                                Nothing ->
                                    p
                        )
                        model.pages
            in
                ( { model | saveState = Saved, pages = updatedPages }
                , Cmd.none
                )

        PageSaved (Err e) ->
            let
                _ =
                    println ("[mini-notion] PageSaved: " ++ Error.toString e)
            in
                ( { model | saveState = SaveError "Could not save." }
                , Cmd.none
                )

        -- Sharing ------------------------------------------------------
        UpdateShareInput v ->
            ( { model | shareInput = v }, Cmd.none )

        SharePage ->
            case ( model.session, model.selected, String.trim model.shareInput ) of
                ( Just s, Just pageId, trimmedEmail ) ->
                    if trimmedEmail == "" || trimmedEmail == s.email then
                        ( { model | notice = "Cannot share with yourself or empty email." }
                        , Cmd.none
                        )
                    else
                        ( { model | shareInput = "" }
                        , Cmd.perform
                            (Db.addShare pageId trimmedEmail "editor" s.id)
                            ShareAdded
                        )

                _ ->
                    ( model, Cmd.none )

        ShareAdded (Ok _) ->
            case model.selected of
                Just pageId ->
                    ( model
                    , Cmd.perform (Db.listShares pageId) SharesLoaded
                    )

                Nothing ->
                    ( model, Cmd.none )

        ShareAdded (Err e) ->
            let
                _ =
                    println ("[mini-notion] ShareAdded: " ++ Error.toString e)
            in
                ( { model | notice = "Could not share page." }, Cmd.none )

        UnsharePage email ->
            case ( model.session, model.selected ) of
                ( Just _, Just pageId ) ->
                    ( model
                    , Cmd.perform (Db.removeShare pageId email) ShareRemoved
                    )

                _ ->
                    ( model, Cmd.none )

        ShareRemoved (Ok _) ->
            case model.selected of
                Just pageId ->
                    ( model
                    , Cmd.perform (Db.listShares pageId) SharesLoaded
                    )

                Nothing ->
                    ( model, Cmd.none )

        ShareRemoved (Err _) ->
            ( { model | notice = "Could not remove share." }, Cmd.none )

        SharesLoaded (Ok shares) ->
            ( { model | shares = shares }, Cmd.none )

        SharesLoaded (Err _) ->
            ( { model | shares = [] }, Cmd.none )

        -- Collab Tick --------------------------------------------------
        -- Nested cases (rather than a tuple-destructure case) so the
        -- Sky->Go codegen doesn't emit duplicate variable bindings
        -- when two branches both bind `Just s`. See v0.13.1 codegen
        -- regression around line 1126 of generated main.go.
        Tick ->
            case model.session of
                Nothing ->
                    ( model, Cmd.none )

                Just s ->
                    case model.selected of
                        Just pageId ->
                            ( model
                            , Cmd.batch
                                [ Cmd.perform (Db.getPage pageId s.id s.email) PageContentReloaded
                                , Cmd.perform (Db.listPages s.id s.email) PagesLoaded
                                ]
                            )

                        Nothing ->
                            ( model
                            , Cmd.perform (Db.listPages s.id s.email) PagesLoaded
                            )

        PageContentReloaded (Ok (Just page)) ->
            -- Avoid clobbering an edit in flight: only update draft if
            -- the user has not typed recently (saveState back to Saved)
            -- and the remote content differs.
            if model.saveState == Saved && page.content /= model.draft then
                ( { model | draft = page.content }, Cmd.none )
            else
                ( model, Cmd.none )

        PageContentReloaded _ ->
            ( model, Cmd.none )



-- Helpers ----------------------------------------------------------


saveDraftTask : Model -> String -> Task Error Int
saveDraftTask model draft =
    case ( model.session, model.selected ) of
        ( Just s, Just pageId ) ->
            Db.savePage pageId s.id s.email (titleFrom draft) draft

        _ ->
            Task.succeed 0


loadSharesIfSelected : Maybe Int -> Cmd.Cmd Msg
loadSharesIfSelected sel =
    case sel of
        Just pageId ->
            Cmd.perform (Db.listShares pageId) SharesLoaded

        Nothing ->
            Cmd.none


titleFrom : String -> String
titleFrom draft =
    case List.head (String.split "\n" draft) of
        Just line ->
            let
                trimmed =
                    String.trim line
            in
                if trimmed == "" then
                    "Untitled"
                else
                    String.slice 0 60 trimmed

        Nothing ->
            "Untitled"


friendlyAuthError : Error -> String
friendlyAuthError e =
    let
        s =
            Error.toString e
    in
        if String.contains "UNIQUE" s || String.contains "unique" s then
            "That email is already registered. Try signing in."
        else if String.contains "wrong email or password" s then
            "Wrong email or password."
        else
            s
